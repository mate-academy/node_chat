{
  "name": "node_chat",
  "version": "1.0.0",
  "private": true,
  "description": "Chat app com Vite (React + TS) e server Node",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --ignore-path .prettierignore --write \"./{src,server}/**/*.{js,jsx,ts,tsx}\" \"vite.config.{ts,mts,js,mjs}\"",
    "lint": "npm run format && mate-scripts lint",
    "test": "npm run lint && npm run test:only",
    "test:only": "mate-scripts test",
    "update": "mate-scripts update",
    "postinstall": "npm run update"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@mate-academy/scripts": "2.1.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "typescript": "5.5.4",
    "vite": "^5.4.0"
  }
}
