    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.17.2",
    "sequelize": "^6.37.7",
