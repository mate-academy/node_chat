  "main": "server/src/index.js",
  "scripts": {
    "init": "mate-scripts init",
    "start": "node src/index.js",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './client/**/*.js' './server/src/**/*.js'",
