{
  "name": "node_chat",
  "version": "1.0.0",
  "description": "Chat using Node.js",
  "main": "server/src/index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "init": "mate-scripts init",
    "start": "node server/src/index.js",
    "lint": "npm run format && mate-scripts lint client/src server/src",
    "format": "prettier --ignore-path .prettierignore --write './**/src/**/*.{js,ts}'",
    "test:only": "mate-scripts test",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/eslint-config-react": "^0.0.17",
    "@mate-academy/scripts": "^2.1.3",
    "@mate-academy/stylelint-config": "^0.0.15",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "react-scripts": "^5.0.1",
    "stylelint": "^16.26.1"
  },
  "mateAcademy": {
    "projectType": "react"
  }
}
