{
  "name": "node_chat",
  "version": "1.0.0",
  "description": "Chat using Node.js",
  "main": "dist/index.js",
  "scripts": {
    "init": "mate-scripts init",
    "build": "tsc",
    "dev": "nodemon",
    "start": "npm run build && node dist/index.js",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,ts}'",
    "test:only": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run build && npm run test:only",
    "client:dev": "npm --prefix src/client run dev"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.0",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.3.2",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "mateAcademy": {
    "projectType": "javascript"
  }
}
