{
  "name": "node_chat",
  "version": "1.0.0",
  "description": "Chat using Node.js",
  "scripts": {
    "init": "mate-scripts init",
    "start": "nodemon beck/src/server.js",
    "start:frontend": "vite --config front/vite.config.ts",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,ts}'",
    "test:only": "mate-scripts test",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "build": "vite build",
    "clean": "rimraf dist && vite build --emptyOutDir"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/preset-react": "^7.24.7",
    "@linthtml/linthtml": "^0.10.1",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^1.9.12",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "rimraf": "^6.0.1"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "dependencies": {
    "@types/react": "^18.3.9",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "bulma": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.15",
    "nodemon": "^3.1.7",
    "passport": "^0.7.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sass": "^1.79.4",
    "sequelize": "^6.37.3",
    "socket.io-client": "^4.8.1",
    "uuidv4": "^6.2.13",
    "vite": "^5.4.8",
    "ws": "^8.18.0"
  }
}
