{
  "type": "module",
  "name": "node_chat",
  "scripts": {
    "start": "nodemon ./src/index.ts",
    "dev": "nodemon",
    "build": "tsup src/index.ts --format esm --outDir dist",
    "start:build": "node dist/index.js",
    "dev:build": "npm run build && node dist/index.js",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,ts}'",
    "test": "npm run lint && npm run test:only",
    "lint": "npm run format && mate-scripts lint",
    "test:only": "mate-scripts test",
    "prod:setup": "npm i && npx prisma migrate deploy && npx prisma generate && npm run build",
    "prod:start": "npm run start:build",
    "prod": "npm run prod:setup && npm run prod:start"
  },
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "mate-scripts": "^0.0.1",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.14",
    "pg": "^8.19.0",
    "ws": "^8.19.0"
  }
}
