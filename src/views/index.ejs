<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>
  <body>
    <div id="app" style="display: none" class="h-screen flex flex-col">
      <div class="flex h-full">
        <div class="w-1/4 border-r border-gray-300 flex flex-col">
          <div class="flex justify-between items-center border-b border-gray-200 p-2">
            <h2 class="font-bold">Chats</h2>
            <button class="bg-blue-500 text-white px-2 py-1 rounded" @click="createRoom">
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
          <ul class="flex-grow overflow-y-auto p-2" id="rooms-list">
            <li
              v-for="room in rooms"
              :key="room.id || room._id"
              class="p-2 border-b border-gray-200 hover:bg-gray-100 cursor-pointer flex justify-between items-center"
              :class="{ 'bg-gray-100': selectedRoom === (room.id || room._id) }"
              @click="selectRoom(room.id || room._id)"
            >
              <div>
                {{ room.name }}
                <span class="text-xs text-gray-500 block">Owner: {{ room.owner }}</span>
              </div>
              <div v-if="room.owner === username">
                <button class="bg-blue-500 text-white px-2 py-1 rounded" @click.stop="toggleMenu($event, room)">
                  <i class="fa-solid fa-ellipsis"></i>
                </button>
              </div>
            </li>
          </ul>
        </div>

        <div class="flex-grow flex flex-col">
          <div class="flex-grow overflow-y-auto p-2" id="messages-list">
            <div v-for="msg in messages" :key="msg._id" class="mb-2">
              <div :class="{ 'justify-end': msg.sender === username }" class="flex">
                <div
                  :class="{
                    'bg-blue-500 text-white': msg.sender === username,
                    'bg-gray-200': msg.sender !== username,
                  }"
                  class="p-2 rounded-md inline-block"
                >
                  <strong>{{ msg.sender }}</strong>
                  <div>{{ msg.content }}</div>
                  <span class="text-xs">{{ formatDate(msg.createdAt) }}</span>
                </div>
              </div>
            </div>
          </div>
          <div class="border-t border-gray-300 p-2">
            <form @submit.prevent="sendMessage">
              <input
                type="text"
                v-model="newMessage"
                placeholder="Type a message..."
                class="w-full border rounded px-2 py-1"
              />
            </form>
          </div>
        </div>
      </div>

      <div
        v-if="menuVisible"
        :style="{ top: menuY + 'px', left: menuX + 'px' }"
        class="absolute bg-white shadow-lg border border-gray-200 rounded-md w-40"
      >
        <ul class="py-2">
          <li
            @click="selectOption('rename', currentContext)"
            class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
          >
            Rename
          </li>
          <li
            @click="selectOption('delete', currentContext)"
            class="px-4 py-2 hover:bg-gray-100 cursor-pointer"
          >
            Delete
          </li>
        </ul>
      </div>
    </div>

    <script type="module">
      import { createApp, ref, onMounted } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.js';

      createApp({
        setup() {
          const rooms = ref([]);
          const selectedRoom = ref(null);
          const messages = ref([]);
          const newMessage = ref('');
          const username = ref('');
          const menuVisible = ref(false);
          const menuX = ref(0);
          const menuY = ref(0);
          const currentContext = ref(null);
          let socket;

          const authUser = () => {
            const storedUsername = localStorage.getItem('username') || prompt('Enter your username:');
            if (!storedUsername) {
              alert('Username is required');
              location.reload();
            }
            localStorage.setItem('username', storedUsername);
            return storedUsername;
          };

          const fetchRooms = async () => {
            try {
              const response = await fetch('/api/rooms', {
                headers: { 'Authorization': username.value }
              });
              const data = await response.json();
              rooms.value = data;
            } catch (error) {
              console.error(error);
            }
          };

          const fetchMessages = async (roomId) => {
            try {
              const response = await fetch(`/api/messages/${roomId}`, {
                headers: { 'Authorization': username.value }
              });
              const data = await response.json();
              messages.value = data;

              setTimeout(() => {
                document.querySelector('#messages-list').scrollTo(0, document.querySelector('#messages-list').scrollHeight);
              }, 100);
            } catch (error) {
              console.error(error);
            }
          };

          const selectRoom = (roomId) => {
            if (selectedRoom.value === roomId) {
              selectedRoom.value = null;
              messages.value = [];
              return;
            }
            selectedRoom.value = roomId;
            fetchMessages(roomId);
          };

          const toggleMenu = (event, context) => {
            menuVisible.value = !menuVisible.value;
            if (menuVisible.value) {
              menuX.value = event.pageX;
              menuY.value = event.pageY;
              currentContext.value = context;
            }
          };

          const closeMenu = () => {
            menuVisible.value = false;
          };

          const renameRoom = async (roomId, newName) => {
            try {
              await fetch(`/api/rooms/${roomId}`, {
                method: 'PUT',
                headers: {
                  'Content-Type': 'application/json',
                  'Authorization': username.value,
                },
                body: JSON.stringify({ name: newName }),
              });
              fetchRooms();
            } catch (error) {
              console.error(error);
            }
          };

          const deleteRoom = async (roomId) => {
            try {
              await fetch(`/api/rooms/${roomId}`, {
                method: 'DELETE',
                headers: { 'Authorization': username.value },
              });
              if (selectedRoom.value === roomId) {
                selectedRoom.value = null;
                messages.value = [];
              }
              fetchRooms();
            } catch (error) {
              console.error(error);
            }
          };

          const selectOption = (option, context) => {
            if (option === 'rename') {
              const newName = prompt('Enter new name:');
              if (newName) {
                renameRoom(context.id || context._id, newName);
              }
            } else if (option === 'delete') {
              if (confirm('Are you sure you want to delete this room?')) {
                deleteRoom(context.id || context._id);
              }
            }
            closeMenu();
          };

          const createRoom = async () => {
            try {
              const roomName = prompt('Enter room name:');
              if (!roomName) return;
              const response = await fetch('/api/rooms', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Authorization': username.value,
                },
                body: JSON.stringify({ name: roomName }),
              });
              const room = await response.json();
              rooms.value.push(room);
              selectedRoom.value = room.id || room._id;
              fetchMessages(selectedRoom.value);
            } catch (error) {
              console.error(error);
            }
          };

          const sendMessage = async () => {
            if (!newMessage.value.trim() || !selectedRoom.value) return;
            try {
              await fetch(`/api/messages/${selectedRoom.value}`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Authorization': username.value,
                },
                body: JSON.stringify({ content: newMessage.value }),
              });
              newMessage.value = '';
            } catch (error) {
              console.error(error);
            }
          };
          
          const formatDate = (dateStr) => {
            const date = new Date(dateStr);
            return date.toLocaleTimeString();
          };
          
          onMounted(() => {
            username.value = authUser();
            document.querySelector('#app').style.display = 'block';
            fetchRooms();
            socket = io({
              transports: ['websocket'],
              auth: { username: username.value },
            });
            socket.on('message', (data) => {
              if (data.type === 'create-message') {
                const msg = data.payload;
                if (msg.room === selectedRoom.value) {
                  messages.value.push(msg);
                  if (msg.sender === username.value) {
                    setTimeout(() => {
                      document.querySelector('#messages-list').scrollTo(0, document.querySelector('#messages-list').scrollHeight);
                    }, 100);
                  }
                }
              } else if (data.type === 'create-room' || data.type === 'rename-room' || data.type === 'delte-room') {
                fetchRooms();
              }
            });
            document.addEventListener('click', (event) => {
              if (!event.target.closest('button')) closeMenu();
            });
          });

          return {
            rooms,
            selectedRoom,
            messages,
            newMessage,
            username,
            menuVisible,
            menuX,
            menuY,
            currentContext,
            selectRoom,
            toggleMenu,
            closeMenu,
            selectOption,
            createRoom,
            sendMessage,
            formatDate,
          };
        },
      }).mount('#app');
    </script>
  </body>
</html>
