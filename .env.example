PORT=3000
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=node_chat
DATABASE_URL=postgresql://user:password@localhost:5432/node_chat

JWT_SECRET=some-jwt-secret
EMAIL=some-email@gmail.com
EMAIL_PASSWORD=some-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
CLIENT_HOST=http://localhost:5173
GOOGLE_CLIENT_ID=some-google-client-id
CORS_ORIGIN=http://localhost:5173,some-other-origin.com
REDIS_URL=redis://localhost:6379

# Set to "true" only if this app is deployed behind a reverse proxy that you
# trust to set X-Forwarded-For correctly (nginx, ALB, Cloudflare, etc.).
# Leave unset/false for local dev or direct exposure.
TRUST_PROXY=false
